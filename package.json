{
  "name": "pawsconnect",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check:deployment": "node scripts/check-operations-schema.mjs",
    "check:live": "node scripts/check-live-contract.mjs",
    "dev": "concurrently -k -n API,WEB -c blue,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "npm run start -w server",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
