PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI assistant (docs/ASSISTANT.md). Server only.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_REASONING_EFFORT=
# Transactional email (order, adoption, rescue, refund and donation updates). Both are required.
# RESEND_FROM must be an address on a domain verified in Resend, e.g. PawsConnect <updates@your-domain>.
RESEND_API_KEY=
RESEND_FROM=
# Set only behind the documented number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Stripe. Test keys (sk_test_...) use the sandbox. The webhook secret (whsec_...) comes from the
# endpoint you register for POST /api/webhooks/stripe, or from `stripe listen` during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: your own Nominatim / OSRM instances. Defaults are the public OpenStreetMap services (light use only).
# Shelter transport takes its road distance and travel time from OSRM_URL. The default is a public demonstration
# server with no uptime guarantee: when it does not answer, customers see a retry message and cannot submit.
# For real traffic, set OSRM_URL to a hosted or self-hosted OSRM (same /route/v1/driving API).
NOMINATIM_URL=
OSRM_URL=
# Operations: leave blank until a separately secured worker has passed staging tests.
# 32+ random characters; server and worker only. Never use a VITE_ variable.
OPERATIONS_WORKER_SECRET=
# Allow-list: backup,restore_drill,deployment,rollback. Production restore is blocked.
OPERATIONS_WORKER_KINDS=
# Optional read-only inventory. Use a project-scoped Management API token with backups_read.
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
# Release details shown under IT Operations → Deployments. `npm run deploy` sets these
# for each deployment; empty values are displayed as not recorded.
RELEASE_COMMIT=
RELEASE_BRANCH=
RELEASE_DATE=
RELEASE_NOTES=

# Set to true in production to refuse the seeded demo accounts (*@pawsconnect.test). They are not deleted.
DEMO_ACCOUNTS_DISABLED=
